# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage
/playwright-report
/storybook-static
/test-results

# next.js
/.next/
/out/
/.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated local data and exports
/data/
/local-data/
/uploads/
/exports/

# raw partner artifacts are intentionally excluded from this repo
*.pdf
*.zip
*.xlsx
!fixtures/customer-x-functional-requirements.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
