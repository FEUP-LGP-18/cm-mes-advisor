# Example placeholders only. Do not put real partner, MES, AWS, Bedrock, Anthropic, Supabase, or MCP secrets in this file.
# Supabase Auth. Leave unset to run in local mock-only mode with no auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Canonical app URL for auth email redirects. Set in Production; leave unset in Preview to use the preview origin.
NEXT_PUBLIC_SITE_URL=https://cm-mes-advisor.vercel.app
# Server-only Supabase admin key. Only set locally when a server-only task explicitly needs service-role access.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key-here

GENERATION_MODE=mock
REQUIREMENT_GENERATION_PROVIDER=bedrock
MES_BASE_URL=https://example.invalid/critical-manufacturing-mes
# Use an external MCP URL, or use "self" to serve the repo-grounded MCP endpoint from this app.
MCP_SERVER_URL=https://example.invalid/mcp
# SELF_MCP_BASE_URL is optional for local non-3000 self-hosted MCP checks.
SELF_MCP_BASE_URL=
BEDROCK_MODEL_ID=example-bedrock-model-id
# Use either the standard AWS credentials below OR a Bedrock bearer token.
AWS_ACCESS_KEY_ID=example-access-key-id
AWS_SECRET_ACCESS_KEY=example-secret-access-key
AWS_REGION=eu-west-1
AWS_SESSION_TOKEN=example-session-token
AWS_BEARER_TOKEN_BEDROCK=ABSKexample-bedrock-bearer-token
MCP_USER_ACCOUNT=consultant@example.com
AI_SMOKE_TEST_TOKEN=
VERCEL_PROTECTION_BYPASS=

# Direct Anthropic alternative for real requirement generation. Keep the API key server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1200
ANTHROPIC_TEMPERATURE=0.1
