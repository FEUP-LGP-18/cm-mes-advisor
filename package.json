{
  "name": "cm-mes-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm docs:source && next build",
    "start": "next start",
    "lint": "eslint",
    "docs:source": "fumadocs-mdx",
    "typecheck": "pnpm docs:source && rm -rf .next/types .next/dev/types tsconfig.tsbuildinfo && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:ai": "node scripts/requirements-ai-smoke.mjs",
    "smoke:ai:local": "node scripts/requirements-ai-smoke.mjs --url http://localhost:3000 --expect-provider anthropic --require-source-reference",
    "smoke:ai:vercel": "node scripts/requirements-ai-smoke.mjs --expect-provider anthropic --require-source-reference --require-url",
    "audit:ai:vercel": "node scripts/requirements-full-workbook-vercel-audit.mjs",
    "vercel:mcp:tunnel": "node scripts/vercel-mcp-tunnel.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "review:ui": "./scripts/codex/review-ui.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1032.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "exceljs": "^4.4.0",
    "fumadocs-core": "^16.8.3",
    "fumadocs-mdx": "^14.3.1",
    "fumadocs-ui": "^16.8.3",
    "jszip": "^3.10.1",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prettier": "^3.8.2",
    "storybook": "^10.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
